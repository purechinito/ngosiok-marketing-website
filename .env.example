# Supabase - both values are safe to expose in the browser bundle.
# Find them in your Supabase project under Settings -> API.
#
# Use the "anon / public" key. NEVER put the service_role key here: it bypasses
# row level security and would be readable by anyone who views the bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
